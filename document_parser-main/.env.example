# 路由策略：local_first 或 quality_first
DOCUMENT_PARSER_ROUTE_PROFILE=local_first

# true 允许将文件上传 MinerU；false 会将云端候选排除并使用本地回退。
DOCUMENT_PARSER_ALLOW_CLOUD=true

# 只有本机 LibreOffice 已通过无头转换检查后才设置为 true。
DOCUMENT_PARSER_LIBREOFFICE_AVAILABLE=false

# MinerU 精准解析 API。Token 不得提交到 Git，当前 Token 有效期为 90 天。
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4

# 可选。命令已在 PATH 中时保持为空；也可填写其他电脑上的绝对路径。
DOCLING_EXECUTABLE=
ANYDOC_EXECUTABLE=
